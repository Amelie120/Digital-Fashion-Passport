# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# This .env.example IS committed — it shows other developers which
# variables they need, without exposing any real secrets.

# ── Local Anvil (safe, fake) ─────────────────────────────────
# Anvil's built-in test account #0. Public, fake money, local only.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Sepolia testnet (your real key — keep secret) ────────────
# Get a free RPC URL from alchemy.com or infura.io
SEPOLIA_RPC_URL=

# Export from MetaMask. Use a THROWAWAY wallet, never one holding real funds.
SEPOLIA_PRIVATE_KEY=

# Optional: for verifying your contract on Etherscan after deploying
ETHERSCAN_API_KEY=
